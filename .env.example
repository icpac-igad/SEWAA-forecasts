# Dataset selection for the standalone `web`/`jobs` services (imerg (default), chirps, or rfe)
CGAN_DATASET=imerg

# Container work home (default: /opt/cgan)
# CTNR_WORK_HOME=/opt/cgan

# Nginx proxy home (default: /opt/interface)
# PROXY_WORK_HOME=/opt/interface

# Web API workers (default: 24)
# WEB_API_WORKERS=24

# HTTP/HTTPS ports (default: 80/443)
# HTTP_PORT=80
# HTTPS_PORT=443

# Container memory cap / soft reservation for web + all jobs services (default: 16g / 4g).
# The GAN inference loop (forecast_date.py) leaks memory per gen.predict() call across a
# plain Python loop; ensemble_members: 1000 (6h_accumulations/cGAN/dsrnngan/forecast.yaml,
# 24h_accumulations/cGAN/dsrnngan/forecast.yaml) needs this much headroom on the host
# running the `jobs` service -- lower it only if you also reduce ensemble_members.
# CGAN_MEM_LIMIT=16g
# CGAN_MEM_RESERVATION=4g

# ── Data store (single root for ALL interface + forecast data) ───────────────
# Every volume in docker-compose.yml resolves relative to this one root by default:
#   ${STORE}/interface/<dataset>/...
#   ${STORE}/forecasts/<dataset>/<accumulation>/{cGAN_forecasts,IFS_forecast_data}/...
# where <dataset> is imerg, rfe, or chirps. Point this at an external disk/volume in
# production instead of a path inside the repo, e.g.:
#   STORE=/mnt/data/cgan
# Defaults to ./store (repo-relative) if unset.
# STORE=./store

# Fine-grained overrides (rarely needed — only if one dataset's data must live
# somewhere STORE doesn't cover, e.g. spread across multiple disks). Each defaults to
# the corresponding ${STORE}/... path above and only needs setting to deviate from it.
# VIZ_READY_DATA_DIR=${STORE}/interface/imerg
# cGAN_6h_FORECASTS_DIR=${STORE}/forecasts/imerg/6h/cGAN_forecasts
# IFS_6h_FORECASTS_DIR=${STORE}/forecasts/imerg/6h/IFS_forecast_data
# cGAN_24h_FORECASTS_DIR=${STORE}/forecasts/imerg/24h/cGAN_forecasts
# IFS_24h_FORECASTS_DIR=${STORE}/forecasts/imerg/24h/IFS_forecast_data

# ── RFE job (jobs-rfe service) ────────────────────────────────────────────
# RFE_JOBS_CNTR_NAME=cgan-rfe-jobs
# RFE_VIZ_DATA_DIR=${STORE}/interface/rfe
# RFE_cGAN_24h_FORECASTS_DIR=${STORE}/forecasts/rfe/24h/cGAN_forecasts
# RFE_IFS_24h_FORECASTS_DIR=${STORE}/forecasts/rfe/24h/IFS_forecast_data

# ── CHIRPS job (jobs-chirps service) ──────────────────────────────────────
# CHIRPS_JOBS_CNTR_NAME=cgan-chirps-jobs
# CHIRPS_VIZ_DATA_DIR=${STORE}/interface/chirps
# CHIRPS_cGAN_24h_FORECASTS_DIR=${STORE}/forecasts/chirps/24h/cGAN_forecasts
# CHIRPS_IFS_24h_FORECASTS_DIR=${STORE}/forecasts/chirps/24h/IFS_forecast_data
